# Copy to .env and fill in. .env is gitignored; never commit it.

# 1Password secret reference to the GitHub token that registers runners.
# deskrunner reads it with the `op` CLI on start and restart. Plain tokens are
# not supported, so the token itself is never stored in this folder.
#
# Use the item's unique ID, not its title: titles can be duplicated or renamed.
# Get the ID in the 1Password app (item menu > Copy Item UUID) or with:
#   op item get "<title>" --vault Private --format json | jq -r .id
TOKEN_REF=op://<vault-id>/<item-id>/credential

# Org or owner/repo used when deskrunner.ps1 is called without a target.
DEFAULT_TARGET=

# Optional tuning (per runner container)
RUNNER_NAME_PREFIX=desk
RUNNER_CPUS=4
RUNNER_MEMORY=6g
